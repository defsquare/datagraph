# Release config for bin/release.sh — copy to bin/release.env (git-ignored) and fill in.
# bin/release.sh auto-sources bin/release.env if it exists.
# Override the path with DATAGRAPH_RELEASE_ENV=/some/other.env if needed.
#
# R2 credentials are NOT set here: `npx wrangler` uses its own OAuth login
# (`wrangler login`); set CLOUDFLARE_ACCOUNT_ID only if the account is ambiguous.

# Public base URL serving the R2 objects.
export DATAGRAPH_DL_BASE_URL="https://dl.datagraph.defsquare.com"

# R2 bucket name.
export DATAGRAPH_R2_BUCKET="datagraph"

# Local checkout of the Homebrew tap repo (github.com/defsquare/homebrew-tap).
export DATAGRAPH_TAP_DIR="$HOME/Workspace/defsquare/homebrew-tap"
