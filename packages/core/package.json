{
  "name": "@defsquare/data-graph-core",
  "version": "0.1.0",
  "description": "Headless graph engine for data-graph: builds an entity/reference graph from arbitrary JSON, plus search indexing and ELK-based layout — no rendering dependency.",
  "keywords": [
    "graph",
    "json",
    "visualization",
    "ddd",
    "aggregate",
    "entity",
    "layout",
    "elk",
    "search-index",
    "jsoncrack"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defsquare/data-graph.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./graph-layout": {
      "types": "./dist/graph-layout.d.ts",
      "import": "./dist/graph-layout.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/graph-layout.ts --format esm --dts",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "tsx bench/bench.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "elkjs": "^0.12.0"
  }
}
