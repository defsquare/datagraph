{
  "name": "@defsquare/data-graph",
  "version": "0.1.0",
  "description": "jsoncrack-style visualization for complex objects (aggregates/entities) with real reference edges — Pixi.js renderer, expand/collapse, search, and theming, on top of @defsquare/data-graph-core.",
  "keywords": [
    "visualization",
    "graph",
    "json",
    "ddd",
    "aggregate",
    "entity",
    "pixi",
    "pixi.js",
    "jsoncrack",
    "canvas"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/defsquare/data-graph",
    "directory": "packages/renderer"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@defsquare/data-graph-core": "workspace:*",
    "pixi.js": "^8.0.0",
    "elkjs": "^0.12.0"
  }
}
