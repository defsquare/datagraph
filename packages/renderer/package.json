{
  "name": "@defsquare/datagraph",
  "version": "0.1.0",
  "description": "Interactive visualization for arbitrary JSON driven by an ids/refs/groups config, with real reference edges — Pixi.js renderer, expand/collapse, search, and theming, on top of @defsquare/datagraph-core.",
  "keywords": [
    "visualization",
    "graph",
    "json",
    "data-first",
    "foreign-keys",
    "reference-edges",
    "pixi",
    "pixi.js",
    "canvas"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defsquare/datagraph.git",
    "directory": "packages/renderer"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./graph-layout-worker": "./dist/graph-layout-worker.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@defsquare/datagraph-core": "workspace:*",
    "@defsquare/datagraph-tokens": "workspace:*",
    "pixi.js": "^8.0.0",
    "elkjs": "^0.12.0"
  }
}
