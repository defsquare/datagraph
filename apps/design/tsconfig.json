{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    // The playground imports the sources by their exact path, extension
    // included (`@tokens/css.ts`): Vite is the one resolving, and handing it
    // the file rather than a specifier to guess removes any ambiguity. TS
    // rejects an explicit `.ts` extension without this option (which requires
    // `noEmit`, set just above).
    "allowImportingTsExtensions": true,
    // The sandbox imports the demo's fixtures (`shop.json`) as modules, which
    // Vite does natively. Without this option, `tsc` rejects the import — and
    // copying the fixture into a `.ts` would make it drift from the one the
    // file-mode e2e tests replay.
    "resolveJsonModule": true,
    // Mirror of `vite.config.ts`'s aliases — see over there why there are two
    // families of entries. `tsc --noEmit` does not read the Vite config:
    // without these `paths`, the typecheck would resolve to the `dist/` builds
    // (or fail, for want of a declared dependency) where the bundler serves the
    // sources. Two divergent resolutions means a typecheck that validates
    // something other than what runs.
    "paths": {
      "@tokens/*": ["../../packages/tokens/src/*"],
      "@renderer/*": ["../../packages/renderer/src/*"],
      "@core/*": ["../../packages/core/src/*"],
      "@chrome/*": ["../../packages/chrome/src/*"],

      "@defsquare/data-graph-core/graph-layout": ["../../packages/core/src/graph-layout.ts"],
      "@defsquare/data-graph-core": ["../../packages/core/src/index.ts"],
      "@defsquare/data-graph/graph-layout-worker": ["../../packages/renderer/src/graph-layout-worker.ts"],
      "@defsquare/data-graph-tokens/css": ["../../packages/tokens/src/css.ts"],
      "@defsquare/data-graph-tokens": ["../../packages/tokens/src/index.ts"],
      "@defsquare/data-graph-chrome": ["../../packages/chrome/src/index.ts"],
      "@defsquare/data-graph": ["../../packages/renderer/src/index.ts"]
    }
  },
  "include": ["src"]
}
